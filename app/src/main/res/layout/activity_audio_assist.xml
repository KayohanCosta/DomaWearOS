<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#1A1A2E" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🔊 Áudio Assistivo" android:textColor="#E94560"
            android:textSize="16sp" android:textStyle="bold" android:gravity="center"
            android:paddingTop="8dp" android:paddingBottom="10dp"/>
        <TextView android:id="@+id/tv_saida_ativa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Detectando saídas..."
            android:textColor="#A8A8B3" android:background="#16213E" android:textSize="9sp"
            android:gravity="center" android:padding="6dp" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/et_mensagem" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Ex: Reunião às 14h na sala 3"
            android:hintTextColor="#666688" android:textColor="#FFFFFF"
            android:background="#16213E" android:textSize="11sp" android:padding="8dp"
            android:minLines="3" android:inputType="textMultiLine" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tv_status_audio" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="⏸ Aguardando..."
            android:textColor="#E94560" android:textSize="11sp" android:gravity="center"
            android:padding="6dp" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_ler_mensagem" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="▶ LER EM VOZ ALTA"
            android:backgroundTint="#E94560" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="6dp" android:minHeight="36dp"/>
        <Button android:id="@+id/btn_parar_audio" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="⏹ PARAR ÁUDIO"
            android:backgroundTint="#0F3460" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textStyle="bold" android:minHeight="36dp"/>
    </LinearLayout>
</ScrollView>
